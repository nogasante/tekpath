{
  "expo": {
    "name": "TekPath",
    "slug": "tekpath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tekpath",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F6E56",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F6E56"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TekPath uses the camera to scan QR checkpoints at entrances and lifts.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TekPath attaches a photo you choose to an accessibility report.",
          "cameraPermission": "TekPath uses the camera when you photograph a lift or ramp."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TekPath uses your location to suggest the nearest outdoor start while you are on the KNUST campus."
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
